library(palmerpenguins)
library(patchwork)
library(RColorBrewer)
library(colorspace)
library(viridis)
library(tidyverse)
# Modify the file path in the code below to properly load the "diamonds_sample.RData" file
load("C:/Users/amyng/OneDrive/Documents/GitHub/codingNCML_Wocs/Amy/R Bootcamp/ggplot expanded - 2/Color Theory/diamonds_sample.RData")
plot_bar = diamonds_sample %>%
ggplot(aes(x = color,
y = depth,
fill = color)) +
stat_summary(fun = "mean", geom = "bar") +
stat_summary(aes(color = color),
fun.data = "mean_se",
geom = "errorbar", width = 0.5)
plot_bar
plot_jitter = diamonds_sample %>%
ggplot(aes(x = cut,
y = price)) +
geom_jitter(aes(color = cut), alpha = 0.7, width = 0.2) +
geom_boxplot(aes(color = cut), alpha = .5) +
stat_summary(fun = "mean", geom = "point", color = "black") +
stat_summary(fun.data = "mean_se", geom = "errorbar", width = .6, color = "black")
plot_jitter
plot_raster = diamonds_sample %>%
ggplot(aes(x = table,
y = carat,
z = price)) +
stat_summary_2d(fun = "mean", geom = "tile", color = "black")
plot_raster
plot_bar +
scale_fill_manual(values = c("turquoise", "orange2", "purple", "hotpink", "darkgreen", "gold", "brown"))
plot_bar +
scale_fill_manual(values = c("cyan", "lightgreen", "yellow", "red","orange", "pink", "purple"))
