library(palmerpenguins)
library(RColorBrewer)
library(colorspace)
library(viridis)
library(tidyverse)
plot_bar = penguins %>%
ggplot(aes(y = flipper_length_mm, x = island ,
fill = island)) +
stat_summary(fun = "mean", geom = "bar") +
scale_y_continuous(expand = c(0,0))
plot_jitter = penguins %>%
ggplot(aes(y = flipper_length_mm , x = island)) +
geom_jitter(height = 0, width = 0.2,
size = 2, alpha = 0.5,
aes(color = )) +
stat_summary(fun.data = "mean_se",
geom = "pointrange",
size = 0.5)
plot_line = penguins %>%
ggplot(aes(y = flipper_length_mm , x = body_mass_g , color = body_mass_g )) +
stat_summary(fun = "mean", geom = "point", size = 2) +
stat_summary(fun = "mean", geom = "line", size = 1)
plot_hex = penguins %>%
ggplot(aes(y = body_mass_g,
x = flipper_length_mm ,
z = bill_depth_mm)) +
stat_summary_hex()
plot_bar = penguins %>%
ggplot(aes(y = body_mass_g, x = island,
fill = island)) +
stat_summary(fun = "mean", geom = "bar") +
scale_y_continuous(expand = c(0,0))
plot_bar
plot_jitter = penguins %>%
ggplot(aes(y = body_mass_g, x = island)) +
geom_jitter(height = 0, width = 0.2,
size = 2, alpha = 0.5,
aes(color = island)) +
stat_summary(fun.data = "mean_se",
geom = "pointrange",
size = 0.5)
plot_jitter
plot_line = penguins %>%
ggplot(aes(y = body_mass_g, x = bill_depth_mm, color = bill_depth_mm)) +
stat_summary(fun = "mean", geom = "point", size = 2) +
stat_summary(fun = "mean", geom = "line", size = 1)
plot_line
plot_hex = penguins %>%
ggplot(aes(y = body_mass_g,
x = bill_depth_mm,
z = flipper_length_mm)) +
stat_summary_hex() +
labs(fill = "Flipper Length")
