ggplot(diamonds, aes(x = carat, y = price)) +
geom_point(alpha = 0.3, color = "darkblue") +
labs(title = "Diamond Price vs. Carat",
subtitle = "Prices increase with carat weight",
x = "Carat",
y = "Price (USD)",
caption = "Diamonds dataset",
tag = "Figure 1")
