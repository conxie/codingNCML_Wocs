base_plot <- penguins %>%
ggplot(aes(y = body_mass_g, x = island)) +
geom_jitter(height = 0, width = 0.1,
size = 2, alpha = 0.3,
aes(color=island)) +
stat_summary(fun.data = "mean_se",
geom = "pointrange",
color = "black",
aes(fill = island),
shape = 21,
size = 0.5)
base_plot
base_plot +
scale_y_continuous(breaks = seq(from = 0, to = 7000, by = 500),
labels = seq(from = 0, to = 7000, by = 500))
base_plot +
coord_cartesian(_lim = c(0,7000)) +
base_plot +
coord_cartesian(lim = c(0,7000)) +
scale_y_continuous(breaks = seq(from = 0, to = 7000, by = 500),
labels = seq(from = 0, to = 7000, by = 500))
base_plot +
coord_cartesian(ylim = c(0,7000)) +
scale_y_continuous(breaks = seq(from = 0, to = 7000, by = 500),
labels = seq(from = 0, to = 7000, by = 500))
base_plot +
coord_cartesian(ylim = c(0,7000)) +
scale_y_continuous(breaks = seq(from = 0, to = 7000, by = 500),
labels = seq(from = 0, to = 7000, by = 500),
expand = c(0,0))
base_plot +
coord_cartesian(ylim = c(0,7000)) +
scale_y_continuous(breaks = seq(from = 0, to = 7000, by = 500),
labels = seq(from = 0, to = 7000, by = 500),
expand = c(0,0)) +
labs(title = "Island vs Body_Mass_G",
subtitle = "X",
y = "Body_Mass_G",
x = "Island",
tag = "X",
caption = "X")
base_plot +
coord_cartesian(ylim = c(0,7000)) +
scale_y_continuous(breaks = seq(from = 0, to = 7000, by = 500),
labels = seq(from = 0, to = 7000, by = 500),
expand = c(0,0)) +
labs(title = "Island vs Body_Mass_G",
subtitle = "Body mass distribution by island.",
y = "Body_Mass_G",
x = "Island",
tag = "Figure 1",
caption = "Penguins Dataset")
modified_plot <- base_plot +
coord_cartesian(ylim = c(0,7000)) +
