diamonds_sample %>%
ggplot(aes(x = clarity)) +
geom_bar(color = "tomato", fill = "purple")
library(tidyverse)
# Modify the file path in the code below to properly load the "diamonds_sample.RData" file
load("C:/Users/amyng/OneDrive/Documents/GitHub/codingNCML_Wocs/Amy/R Bootcamp/ggplot expanded - 2/Geoms and Different Graphs/diamonds_sample.RData")
diamonds_sample %>%
ggplot(aes(x = clarity)) +
geom_bar(color = "tomato", fill = "purple")
diamonds_sample %>%
ggplot(aes(x = color)) +
geom_bar(fill = "violet", color = "blue")
diamonds_sample %>%
ggplot(aes(x = price)) +
geom_histogram(color = "black")
diamonds_sample %>%
ggplot(aes(x = carat)) +
geom_histogram(fill = "cyan",
color = "turquoise") +
geom_vline(aes(xintercept = 0.8))
diamonds_sample %>%
ggplot(aes(x = depth, y = carat)) +
geom_point(color = "blue",
size = 3,
alpha = 0.5,
shape = 15) +
geom_smooth(method = "lm", se = FALSE)
diamonds_sample %>%
ggplot(aes(x = table, y = y)) +
geom_hex()
diamonds_sample %>%
ggplot(aes(x = depth, y = carat)) +
geom_point(color = "blue",
size = 2,
alpha = 0.5,
shape = 15) +
geom_smooth(method = "lm", se = FALSE) +
geom_rug(alpha = .5, size = 2, color = "blue")
library(ggExtra)
p <- ggplot(diamonds_sample, aes(x = table, y = y)) +
geom_hex() +
geom_point(alpha = 0)
ggExtra::ggMarginal(p, type = "histogram")
